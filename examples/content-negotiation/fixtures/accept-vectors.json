  { "name": "text/*", "accept": "text/*", "expected": "html" },
  {
    "name": "markdown preferred",
    "accept": "text/markdown, text/html;q=0.8",
    "expected": "markdown"
  },
  { "name": "html preferred", "accept": "text/html, text/markdown;q=0.8", "expected": "html" },
  {
    "name": "markdown q=0 only",
    "accept": "text/markdown;q=0",
    "expected": "not-acceptable"
  },
  {
    "name": "markdown q=0 with html",
    "accept": "text/markdown;q=0, text/html",
    "expected": "html"
  },
  {
    "name": "html q=0 markdown only",
    "accept": "text/html;q=0, text/markdown",
    "expected": "markdown"
  },
  { "name": "text star vs html", "accept": "text/*;q=0.5, text/html;q=1", "expected": "html" },
  {
    "name": "markdown explicit beats wildcard",
    "accept": "text/markdown;q=1, */*;q=0.1",
    "expected": "markdown"
  },
  {
    "name": "text star html q=0",
    "accept": "text/*;q=1, text/html;q=0",
    "expected": "markdown"
  },
  {
    "name": "text star html low",
    "accept": "text/*;q=0.8, text/html;q=0.1",
    "expected": "markdown"
  },
  {
    "name": "wildcard markdown low",
    "accept": "*/*;q=0.8, text/markdown;q=0.1",
    "expected": "html"
  },
  { "name": "equal weight", "accept": "text/html;q=1, text/markdown;q=1", "expected": "html" },
  {
    "name": "both q=0",
    "accept": "text/html;q=0, text/markdown;q=0",
    "expected": "not-acceptable"
  },
  {
    "name": "mixed case whitespace",
    "accept": "  Text/Markdown , text/html;q=0.8  ",
