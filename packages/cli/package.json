{
  "name": "@thierry-gilgen-ict/engawa-cli",
  "version": "0.1.0",
  "description": "Engawa CLI — inspect, plan, and verify agent-native websites",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/thierry-gilgen-ict/engawa.git",
    "directory": "packages/cli"
  },
  "bugs": {
    "url": "https://github.com/thierry-gilgen-ict/engawa/issues"
  },
  "homepage": "https://github.com/thierry-gilgen-ict/engawa#readme",
  "type": "module",
  "bin": {
    "engawa": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "node --input-type=module -e \"import { rmSync } from 'node:fs'; rmSync('dist',{recursive:true,force:true}); rmSync('tsconfig.build.tsbuildinfo',{force:true})\" && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --root ../.. --config vitest.config.ts packages/cli"
  },
  "dependencies": {
    "@modelcontextprotocol/client": "2.0.0",
    "node-html-parser": "^9.0.1",
    "zod": "^4.2.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=24"
  },
  "devDependencies": {
    "@modelcontextprotocol/node": "2.0.0",
    "@modelcontextprotocol/server": "2.0.0",
    "@thierry-gilgen-ict/engawa-core": "workspace:^",
    "@thierry-gilgen-ict/engawa-discovery": "workspace:^",
    "@thierry-gilgen-ict/engawa-mcp": "workspace:^"
  }
}
