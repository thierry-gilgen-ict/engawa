{
  "name": "@thierry-gilgen-ict/engawa-discovery",
  "version": "0.1.0",
  "description": "llms.txt v2 generation and discovery link metadata for Engawa",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "prepare": "npm run build",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@thierry-gilgen-ict/engawa-core": "workspace:*"
  },
  "publishConfig": {
    "access": "public"
  }
}
